# CARA-FinSent environment variables
# Copy this file to .env and fill in your values.
# The main pipeline (make prepare + make pipeline) requires NO secrets.
# Only data collector scripts 01-03 read from this file.

# Required for: make collect-sec
# SEC EDGAR requires a real "Firstname Lastname email@institution.edu" User-Agent.
SEC_USER_AGENT=

# Optional for: make collect-news (NewsAPI free tier: https://newsapi.org/register)
NEWSAPI_KEY=

# Optional for: make collect-news (Finnhub free tier: https://finnhub.io/register)
FINNHUB_API_KEY=

# Optional: HuggingFace token (only needed for private/gated models)
# HF_TOKEN=hf_...
